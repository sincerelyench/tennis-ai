.page {
  padding: 40rpx 32rpx 80rpx;
  background: #fff;
  min-height: 100vh;
  box-sizing: border-box;
}
.h1 {
  display: block;
  font-size: 36rpx;
  font-weight: 800;
  color: #0f172a;
  margin-bottom: 8rpx;
}
.updated {
  display: block;
  font-size: 22rpx;
  color: #94a3b8;
  margin-bottom: 28rpx;
}
.block {
  margin-bottom: 28rpx;
}
.heading {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #0f172a;
  margin-bottom: 10rpx;
}
.body {
  display: block;
  font-size: 26rpx;
  line-height: 1.65;
  color: #475569;
  margin-bottom: 10rpx;
}
