# Copy to /etc/systemd/system/tennis-ai.service.d/wechat-subscribe-tmpl.conf
# after Yanqing creates templates on mp.weixin.qq.com.
# Do NOT invent IDs. Keep AppSecret out of git.
#
# [Service]
# Environment=WECHAT_MP_TMPL_LADDER=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Environment=WECHAT_MP_TMPL_INVITE=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Environment=WECHAT_MP_TMPL_INVITE_ACCEPTED=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Environment=WECHAT_MP_TMPL_SCORE_CONFIRM=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Environment=WECHAT_MP_TMPL_MESSAGE=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Environment=WECHAT_MP_STATE=formal
#
# Then: systemctl daemon-reload && systemctl restart tennis-ai
