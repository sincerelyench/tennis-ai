# Copy to /etc/systemd/system/tennis-ai.service.d/wechat-subscribe-tmpl.conf
# Template IDs from Yanqing / mp.weixin.qq.com — do NOT invent.
# Keep AppSecret out of git (already in wechat-mp.conf from login).
#
# Full field list: deploy/wechat-subscribe-notify/WECHAT-CONSOLE-TEMPLATES.md
#
# [Service]
# Environment=WECHAT_MP_TMPL_LADDER=
# Environment=WECHAT_MP_TMPL_INVITE=y3dQG1ss-l3h_Ebe2fhWymaigXuuDYgvL_rvgeT7lg
# Environment=WECHAT_MP_TMPL_INVITE_ACCEPTED=
# Environment=WECHAT_MP_TMPL_SCORE_CONFIRM=
# Environment=WECHAT_MP_TMPL_MESSAGE=
# Environment=WECHAT_MP_STATE=formal
#
# Then: systemctl daemon-reload && systemctl restart tennis-ai
#
# Invite template (confirmed): 用户邀约通知
#   thing1=邀约标题  thing2=邀约内容  thing13=邀请人
