.page {
  min-height: 100vh;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(165deg, #ecfdf5 0%, #f0fdfa 42%, #ffffff 100%);
}

.splash {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  padding: 48rpx;
}

.brand-logo {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #ffffff;
  box-shadow: 0 12rpx 28rpx rgba(15, 118, 110, 0.18);
}

.brand-name {
  font-size: 40rpx;
  font-weight: 800;
  color: #0f766e;
  letter-spacing: 2rpx;
}

.status {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #64748b;
}
