<view class="page">
  <view class="brand-row">
    <image class="brand-logo" src="/images/logo.png" mode="aspectFit" />
    <text class="brand-name">涨球乐</text>
  </view>

  <text class="h1">登录</text>
  <text class="lead-mini">请先浏览首页功能介绍；登录为可选。小程序仅支持账号密码登录。登录前须阅读并同意下列协议。</text>
  <button class="btn-ghost back-home" bindtap="onBackHome">返回首页继续浏览</button>

  <!-- ZQ-170: MP password-only — WeChat + phone SMS removed from mini-program UI. -->
  <view class="mode-row" data-mp-wechat-login="off" data-mp-phone-login="off" data-login-mode="password-only" hidden>
    <text>账号密码</text>
  </view>

  <!-- ZQ-168: consent before collecting account info -->
  <view class="consent-row" data-legal-consent="true">
    <checkbox-group bindchange="onConsentChange">
      <label class="consent-label">
        <checkbox value="agree" checked="{{agreedLegal}}" color="#0d9488" />
        <text class="consent-text">
          我已阅读并同意
          <text class="link" catchtap="onOpenTerms">《用户服务协议》</text>
          和
          <text class="link" catchtap="onOpenPrivacy">《隐私政策》</text>
          ，知晓账号信息仅用于登录验证与账号服务。
        </text>
      </label>
    </checkbox-group>
  </view>

  <view class="card" data-login-password="true">
    <text class="label">用户名</text>
    <input
      class="field"
      maxlength="40"
      placeholder="用户名"
      value="{{username}}"
      bindinput="onUsername"
    />
    <text class="label">密码</text>
    <input
      class="field"
      password
      maxlength="72"
      placeholder="密码"
      value="{{password}}"
      bindinput="onPassword"
    />
    <button class="primary" loading="{{loading}}" disabled="{{loading || !agreedLegal}}" bindtap="onPasswordLogin">
      {{loading ? "正在登录…" : "登录"}}
    </button>
  </view>

  <text class="hint" wx:if="{{notice}}">{{notice}}</text>
  <text class="error" wx:if="{{error}}">{{error}}</text>

  <view class="intro-mask" wx:if="{{showIntro}}" catchtouchmove="noop">
    <view class="intro-card">
      <view class="intro-brand">
        <image class="intro-logo" src="/images/logo.png" mode="aspectFit" />
        <text class="intro-brand-name">涨球乐</text>
      </view>
      <text class="intro-title">欢迎来到涨球乐</text>
      <text class="intro-lead">多打球、约对手、看排名、找教练——让我们大家一起涨球乐。</text>
      <view class="intro-list">
        <view class="intro-item" wx:for="{{introPoints}}" wx:key="title">
          <view class="intro-num">{{index + 1}}</view>
          <view class="intro-body">
            <text class="intro-item-title">{{item.title}}</text>
            <text class="intro-item-desc">{{item.desc}}</text>
          </view>
        </view>
      </view>
      <view class="intro-actions">
        <button class="btn-ghost intro-btn" bindtap="onIntroDismiss">跳过</button>
        <button class="primary intro-btn" bindtap="onIntroDismiss">开始</button>
      </view>
    </view>
  </view>
</view>
