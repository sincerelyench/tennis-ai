<view class="page" wx:if="{{match}}" data-zq-match-mvp="1">
  <text class="h1">{{match.title}}</text>
  <text class="lead">{{formatLabel}} · {{match.finalScore}} · {{modeLabel}} · {{match.videoLabel}}</text>

  <view class="court {{match.mode==='ground'?'ground':''}}">
    <view class="score">{{zh ? '计分条' : 'Score'}} · {{match.finalScore}}</view>
    <view class="trace" wx:if="{{ballTrace}}">{{zh ? '球轨迹：开 · 底线到对面底线' : 'Ball trace: on · baseline to baseline'}}</view>
    <view class="trace">{{zh ? '全绿球场 · 无热力色块' : 'All-green court · no heatmap'}}</view>
  </view>
  <text class="hint">{{speedDisclaimer}}</text>
  <view class="legend" data-trace-legend="you-opp">
    <text class="you">{{legendYou}}</text>
    <text class="opp">{{legendOpp}}</text>
  </view>

  <view class="row">
    <view class="chip {{ballTrace?'on':''}}" bindtap="toggleTrace">{{zh ? '球轨迹' : 'Ball trace'}}</view>
    <view class="chip" bindtap="onShare">{{zh ? '分享链接' : 'Share link'}}</view>
  </view>
  <text class="hint" wx:if="{{shareHint}}">{{shareHint}}</text>

  <text class="label">{{zh ? '本分每球球速' : 'Per-shot speeds'}}</text>
  <view class="list" data-section="per-shot-speeds">
    <view class="item shot {{item.side}}" wx:for="{{activeShots}}" wx:key="id">
      <text>{{item.rallyLabel}} · {{item.sideLabel}} · {{item.strokeLabel}}</text>
      <text class="speed">{{item.speedLabel}}</text>
    </view>
    <text class="hint" wx:if="{{!activeShots.length}}">{{zh ? '选一分查看每拍球速与落点序号' : 'Pick a point for per-shot speed'}}</text>
  </view>

  <text class="label">{{zh ? '筛选（已剪空镜）' : 'Filters (trimmed)'}}</text>
  <view class="row">
    <view class="chip {{stroke==='all'?'on':''}}" data-v="all" bindtap="setStroke">{{zh ? '全部技术' : 'All strokes'}}</view>
    <view class="chip {{stroke==='forehand'?'on':''}}" data-v="forehand" bindtap="setStroke">{{zh ? '正手' : 'Forehand'}}</view>
    <view class="chip {{stroke==='backhand'?'on':''}}" data-v="backhand" bindtap="setStroke">{{zh ? '反手' : 'Backhand'}}</view>
    <view class="chip {{stroke==='serve'?'on':''}}" data-v="serve" bindtap="setStroke">{{zh ? '发球' : 'Serve'}}</view>
  </view>
  <view class="row">
    <view class="chip {{result==='all'?'on':''}}" data-v="all" bindtap="setResult">{{zh ? '全部结果' : 'All results'}}</view>
    <view class="chip {{result==='winner'?'on':''}}" data-v="winner" bindtap="setResult">{{zh ? '制胜分' : 'Winner'}}</view>
    <view class="chip {{result==='unforced_error'?'on':''}}" data-v="unforced_error" bindtap="setResult">{{zh ? '非受迫' : 'Unforced'}}</view>
    <view class="chip {{result==='ace'?'on':''}}" data-v="ace" bindtap="setResult">{{zh ? '发球直接得分' : 'Ace'}}</view>
  </view>

  <text class="label">{{zh ? ('全部回合 ' + points.length + ' 分') : ('All rallies · ' + points.length + ' points')}}</text>
  <view class="list all-rallies" data-section="all-rallies">
    <view class="item {{activeId===item.id?'on':''}}" wx:for="{{points}}" wx:key="id" data-id="{{item.id}}" bindtap="pickPoint">
      #{{index+1}} · {{item.setScore}} {{item.scoreBefore}} · {{item.resultLabel}} · {{item.rallyLength}}{{zh?'拍':' shots'}}
    </view>
  </view>

  <text class="label">{{zh ? '击球数据' : 'Shot stats'}}</text>
  <view class="stats">
    <view class="stat"><text class="k">{{zh?'均速':'Avg'}}</text><text class="v">{{avgSpeedLabel}}</text></view>
    <view class="stat"><text class="k">{{zh?'深度':'Depth'}}</text><text class="v">{{match.stats.avgDepth}}</text></view>
    <view class="stat"><text class="k">{{zh?'回合':'Rally'}}</text><text class="v">{{match.stats.avgRally}}</text></view>
    <view class="stat"><text class="k">{{zh?'制胜':'Winners'}}</text><text class="v">{{match.stats.winners}}</text></view>
  </view>

  <text class="label">{{zh ? '涨球教练点评' : 'Zhangqiu Coach'}}</text>
  <view class="card" wx:for="{{match.coaching}}" wx:key="id">
    <text class="item-title">{{zh ? item.title : item.titleEn}}</text>
    <text class="hint">{{zh ? item.body : item.bodyEn}}</text>
    <view class="link" data-id="{{item.jumpPointId}}" bindtap="jumpCoach">{{zh ? '跳到该分' : 'Jump to point'}}</view>
  </view>
</view>
<view class="page" wx:else>
  <text class="h1">{{zh ? '找不到比赛' : 'Match not found'}}</text>
</view>
