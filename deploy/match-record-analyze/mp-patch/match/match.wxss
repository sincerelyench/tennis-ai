.page { padding: 20px 16px 40px; color: #f4efe4; min-height: 100vh; background: #07140e; }
.brand { font-size: 13px; opacity: .75; }
.h1 { display: block; margin-top: 8px; font-size: 20px; font-weight: 700; }
.lead { display: block; margin-top: 8px; font-size: 12px; line-height: 1.5; opacity: .75; }
.card { margin-top: 16px; padding: 14px; border-radius: 12px; border: 1px solid rgba(244,239,228,.15); background: rgba(31,74,56,.35); }
.label { display: block; font-size: 12px; margin-bottom: 8px; opacity: .8; }
.row { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 12px; }
.chip { padding: 8px 12px; border-radius: 10px; border: 1px solid rgba(244,239,228,.2); font-size: 12px; }
.chip.on { background: #1f4a38; border-color: #7dd3a0; color: #d8ffe8; }
.primary, .ghost { margin-top: 10px; text-align: center; padding: 12px; border-radius: 10px; font-size: 14px; font-weight: 600; }
.primary { background: #2f7a56; color: #f4efe4; }
.ghost { border: 1px solid rgba(244,239,228,.25); }
.hint { display: block; margin-top: 8px; font-size: 11px; opacity: .7; line-height: 1.45; }
.item { padding: 10px 0; border-top: 1px solid rgba(244,239,228,.1); }
.item-title { display: block; font-size: 13px; font-weight: 600; }
