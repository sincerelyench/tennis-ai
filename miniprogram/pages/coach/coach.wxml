<view class="page" data-network-coach-chat="true" data-coach-mode="{{isAi ? 'ai-chat' : 'human-message'}}">
  <view class="top">
    <text class="brand">涨球</text>
    <text class="lang" bindtap="onToggleLang">{{locale === 'en' ? '中文' : 'EN'}}</text>
  </view>

  <view class="hdr">
    <text class="title">{{locale === 'en' ? 'My coaches' : '我的教练'}}</text>
    <text class="lead">{{locale === 'en' ? 'Zhangqiu Coach is AI chat; network coaches are real people via messages.' : '涨球教练是 AI 即时问答；网络教练是平台真人，用留言沟通。'}}</text>
  </view>

  <view class="row" data-coach-chat-personas="true">
    <view
      class="chip {{isAi ? 'on' : ''}}"
      data-id="poppy"
      data-coach-kind="zhangqiu"
      data-coach-selected="{{isAi ? 'true' : 'false'}}"
      bindtap="onPickPersona"
    >
      <text class="name" data-coach-name="true">{{locale === 'en' ? 'Zhangqiu Coach' : '涨球教练'}}</text>
      <text class="hint">{{isAi ? (locale === 'en' ? 'Chatting' : '正在问答') : (locale === 'en' ? 'AI coach · Instant Q&A' : 'AI 教练 · 即时问答')}}</text>
    </view>
    <view
      wx:if="{{network}}"
      class="chip {{!isAi ? 'on' : ''}}"
      data-id="{{network.id}}"
      data-coach-kind="network"
      data-coach-selected="{{!isAi ? 'true' : 'false'}}"
      bindtap="onPickPersona"
    >
      <text class="name" data-coach-name="true">{{network.name}}</text>
      <text class="hint">{{!isAi ? (locale === 'en' ? 'Messaging' : '留言中') : (locale === 'en' ? 'Human coach · Messages' : '真人教练 · 留言')}}</text>
      <text wx:if="{{network.style}}" class="style">{{network.style}}</text>
    </view>
  </view>

  <button size="mini" type="primary" data-action="open-coach-picker" bindtap="onOpenPicker">
    {{network ? (locale === 'en' ? 'Change network coach' : '更换网络教练') : (locale === 'en' ? 'Choose coach' : '选教练')}}
  </button>

  <block wx:if="{{isAi}}">
    <view class="log" data-coach-panel="ai-chat">
      <block wx:for="{{messages}}" wx:key="id">
        <view class="bubble {{item.role}}">{{item.text}}</view>
      </block>
    </view>

    <view class="composer" data-coach-composer="ai">
      <input class="input" value="{{draft}}" bindinput="onDraft" placeholder="{{locale === 'en' ? 'Ask Zhangqiu Coach…' : '问问涨球教练…'}}" confirm-type="send" bindconfirm="onSend" />
      <button size="mini" type="primary" loading="{{pending}}" bindtap="onSend">{{locale === 'en' ? 'Send' : '发送'}}</button>
    </view>
  </block>

  <block wx:else>
    <view class="board-intro" data-coach-panel="human-intro">
      <text class="intro">{{locale === 'en' ? ((network.name || 'Network coach') + ' is a real platform coach. Leave a message — they reply later, not instant AI chat.') : ((network.name || '网络教练') + '是平台真人教练。请留言，教练会择时回复——不是即时 AI 问答。')}}</text>
    </view>

    <view class="board" data-coach-panel="human-board">
      <view wx:if="{{!board.length}}" class="empty">{{locale === 'en' ? 'No messages yet. Leave a technique question or training note.' : '还没有留言。写一条技术问题或训练反馈吧。'}}</view>
      <block wx:for="{{board}}" wx:key="id">
        <view class="msg" data-message-id="{{item.id}}">
          <text class="meta">{{item.atLabel}}</text>
          <text class="body">{{item.text}}</text>
          <text class="status">{{locale === 'en' ? 'Sent — waiting for coach reply' : '已留言，等待教练回复'}}</text>
        </view>
      </block>
    </view>

    <view class="composer col" data-coach-composer="message">
      <textarea class="textarea" value="{{draft}}" bindinput="onDraft" placeholder="{{locale === 'en' ? 'Leave a message…' : '给教练留言…'}}" maxlength="500" />
      <button size="mini" type="primary" bindtap="onLeave">{{locale === 'en' ? 'Leave message' : '留言'}}</button>
    </view>
  </block>
</view>
