.page { padding: 16px; background: #eef3f0; min-height: 100vh; box-sizing: border-box; }
.top { display: flex; justify-content: space-between; align-items: center; }
.brand { font-weight: 800; font-size: 18px; color: #14201a; }
.lang { color: #1f7a4c; font-weight: 700; font-size: 12px; }
.hdr { margin: 12px 0; }
.title { display: block; font-size: 20px; font-weight: 800; color: #14201a; }
.lead { display: block; margin-top: 6px; font-size: 13px; color: #5b6b63; line-height: 1.45; }
.row { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 10px; }
.chip {
  flex: 1; min-width: 42%; background: #fff; border: 1px solid #d7e3dc; border-radius: 12px; padding: 10px;
}
.chip.on { border-color: #1f7a4c; background: #eef8f2; }
.name { display: block; font-weight: 800; font-size: 14px; }
.hint { display: block; margin-top: 4px; font-size: 11px; color: #1f7a4c; font-weight: 700; }
.style { display: block; margin-top: 4px; font-size: 11px; color: #5b6b63; }
.log { margin-top: 14px; display: flex; flex-direction: column; gap: 8px; min-height: 180px; }
.bubble {
  max-width: 88%; padding: 8px 10px; border-radius: 12px; font-size: 13px; line-height: 1.45;
}
.bubble.user { align-self: flex-end; background: #1f7a4c; color: #fff; }
.bubble.coach { align-self: flex-start; background: #fff; border: 1px solid #d7e3dc; color: #14201a; }
.composer { margin-top: 12px; display: flex; gap: 8px; align-items: center; }
.input {
  flex: 1; background: #fff; border: 1px solid #d7e3dc; border-radius: 10px; padding: 8px 10px; font-size: 14px;
}
