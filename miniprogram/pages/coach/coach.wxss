.coach-page {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  padding-bottom: 24rpx;
}

.head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.link {
  color: #0d9488;
  font-size: 26rpx;
  font-weight: 600;
}

.tabs {
  display: flex;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.thread {
  flex: 1;
  max-height: 52vh;
  margin-bottom: 16rpx;
}

.bubble {
  margin-bottom: 16rpx;
  padding: 20rpx 22rpx;
  border-radius: 20rpx;
  background: #f1f5f9;
}

.bubble.user {
  background: #ccfbf1;
}

.bubble-role {
  display: block;
  font-size: 22rpx;
  color: #64748b;
  margin-bottom: 6rpx;
}

.bubble-text {
  display: block;
  font-size: 28rpx;
  color: #0f172a;
  white-space: pre-wrap;
  word-break: break-word;
}

.quick {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.composer {
  display: flex;
  gap: 12rpx;
  align-items: center;
}

.compose {
  flex: 1;
  margin-bottom: 0;
}

.send {
  margin-top: 0 !important;
  min-width: 120rpx;
}
