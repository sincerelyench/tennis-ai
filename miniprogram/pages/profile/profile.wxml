<view class="page">
  <view class="brand-row">
    <image class="brand-logo" src="/images/logo.png" mode="aspectFit" />
    <text class="brand-name">涨球</text>
  </view>

  <view class="hero card">
    <text class="hero-name">{{displayName || "未设置显示名"}}</text>
    <text class="muted">{{cityLabel || "未选城市"}} · {{roleLabel}}</text>
  </view>

  <view class="card">
    <text class="h2">资料</text>
    <text class="label">显示名</text>
    <input class="field" maxlength="40" placeholder="真实登录名优先" value="{{draftName}}" bindinput="onName" />
    <button class="primary" size="mini" loading="{{savingName}}" bindtap="onSaveName">保存显示名</button>
    <text class="hint" wx:if="{{nameNote}}">{{nameNote}}</text>

    <text class="label">所在地</text>
    <picker mode="selector" range="{{cityLabels}}" value="{{cityIndex}}" bindchange="onCity">
      <view class="picker">{{cityLabels[cityIndex]}}</view>
    </picker>
    <text class="hint" wx:if="{{cityNote}}">{{cityNote}}</text>
  </view>

  <view class="card menu">
    <view class="row" bindtap="goAnalysis">
      <text>我的报告</text>
      <text class="chev">›</text>
    </view>
    <view class="row" bindtap="goCoach">
      <text>教练对话</text>
      <text class="chev">›</text>
    </view>
    <view class="row" bindtap="goLibrary">
      <text>动作库</text>
      <text class="chev">›</text>
    </view>
  </view>

  <button class="ghost logout" bindtap="onLogout">退出登录</button>
</view>
