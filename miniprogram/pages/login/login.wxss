.page {
  min-height: 100vh;
  padding: 48rpx 36rpx 80rpx;
  box-sizing: border-box;
  background:
    radial-gradient(900rpx 480rpx at 12% -10%, rgba(214, 227, 90, 0.18), transparent 55%),
    radial-gradient(700rpx 420rpx at 90% 10%, rgba(90, 180, 120, 0.12), transparent 50%),
    linear-gradient(165deg, #07140e, #0d2418 48%, #0a1a12);
  color: #eef6ee;
}

.hero {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 12rpx;
  margin-bottom: 40rpx;
}

.logo {
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  margin-bottom: 8rpx;
}

.brand {
  font-size: 64rpx;
  font-weight: 800;
  letter-spacing: 0.16em;
  color: #d6e35a;
  line-height: 1.1;
}

.lead {
  font-size: 34rpx;
  font-weight: 600;
  color: #eef6ee;
  margin-top: 8rpx;
}

.sub {
  font-size: 26rpx;
  color: #8ea196;
  line-height: 1.55;
  max-width: 560rpx;
}

.card {
  margin-top: 12rpx;
  padding: 36rpx 32rpx 40rpx;
  border: 1rpx solid #2d4a3a;
  border-radius: 28rpx;
  background: rgba(16, 36, 27, 0.92);
}

.label {
  display: block;
  font-size: 26rpx;
  color: #8ea196;
  margin-bottom: 16rpx;
}

.field {
  height: 88rpx;
  padding: 0 24rpx;
  border-radius: 16rpx;
  background: #0a1a12;
  border: 1rpx solid #2d4a3a;
  color: #eef6ee;
  font-size: 30rpx;
  margin-bottom: 28rpx;
}

.primary {
  height: 96rpx;
  line-height: 96rpx;
  border-radius: 18rpx;
  background: #d6e35a !important;
  color: #07140e !important;
  font-size: 32rpx;
  font-weight: 700;
  border: none !important;
}

.primary::after {
  border: none;
}

.hint {
  display: block;
  margin-top: 20rpx;
  font-size: 24rpx;
  color: #8ea196;
  line-height: 1.45;
}

.error {
  display: block;
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #f0a0a0;
}
