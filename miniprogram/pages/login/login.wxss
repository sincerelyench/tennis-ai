/* inherits app.wxss light theme */
.page {
  padding-top: 48rpx;
}

.mode-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.mode-chip {
  padding: 14rpx 22rpx;
  border-radius: 999rpx;
  border: 1rpx solid #cbd5e1;
  background: #ffffff;
  font-size: 24rpx;
  color: #0f172a;
}

.mode-chip-on {
  background: #0d9488;
  border-color: #0d9488;
  color: #ffffff;
  font-weight: 700;
}

.code-row {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}

.code-field {
  flex: 1;
}

.code-btn {
  margin-top: 0 !important;
  flex-shrink: 0;
  height: 80rpx;
  line-height: 80rpx;
  padding: 0 22rpx !important;
  font-size: 24rpx !important;
}

/* ZQ-159 product intro (matches web Onboarding) */
.onboard-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 1000;
  background: rgba(0, 0, 0, 0.4);
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding: 32rpx;
  box-sizing: border-box;
}

.onboard-sheet {
  width: 100%;
  max-width: 640rpx;
  max-height: 92vh;
  overflow-y: auto;
  background: #ffffff;
  border-radius: 28rpx;
  padding: 36rpx 32rpx 40rpx;
  box-sizing: border-box;
  box-shadow: 0 16rpx 48rpx rgba(15, 23, 42, 0.18);
}

.onboard-brand {
  margin-bottom: 20rpx;
}

.onboard-title {
  display: block;
  font-size: 40rpx;
  font-weight: 800;
  color: #0f172a;
  margin-bottom: 12rpx;
}

.onboard-lead {
  display: block;
  font-size: 26rpx;
  color: #64748b;
  line-height: 1.55;
  margin-bottom: 28rpx;
}

.onboard-list {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.onboard-item {
  display: flex;
  gap: 18rpx;
  align-items: flex-start;
}

.onboard-num {
  width: 44rpx;
  height: 44rpx;
  border-radius: 999rpx;
  background: #0d9488;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-top: 4rpx;
}

.onboard-copy {
  min-width: 0;
  flex: 1;
}

.onboard-item-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #0f172a;
}

.onboard-item-desc {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #64748b;
  line-height: 1.55;
}

.onboard-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-top: 36rpx;
}

.onboard-btn {
  margin: 0 !important;
}
