<view class="page">
  <view class="brand-row">
    <image class="brand-logo" src="/images/logo.png" mode="aspectFit" />
    <text class="brand-name">涨球乐</text>
  </view>

  <text class="h1">登录</text>

  <view class="mode-row">
    <view
      class="mode-chip {{mode === 'wechat' ? 'mode-chip-on' : ''}}"
      data-mode="wechat"
      bindtap="onMode"
    >微信登录</view>
    <view
      class="mode-chip {{mode === 'password' ? 'mode-chip-on' : ''}}"
      data-mode="password"
      bindtap="onMode"
    >账号密码</view>
    <view
      class="mode-chip {{mode === 'phone' ? 'mode-chip-on' : ''}}"
      data-mode="phone"
      bindtap="onMode"
    >手机验证码</view>
  </view>

  <!-- ZQ-158: WeChat tab = one tap; no displayName on login. Nick after login. -->
  <view class="card" wx:if="{{mode === 'wechat'}}">
    <button class="primary" loading="{{loading}}" disabled="{{loading}}" bindtap="onWechatLogin">
      {{loading ? "正在登录…" : "微信登录"}}
    </button>
  </view>

  <view class="card" wx:if="{{mode === 'password'}}">
    <text class="label">用户名或手机号</text>
    <input
      class="field"
      maxlength="40"
      placeholder="用户名或手机号"
      value="{{username}}"
      bindinput="onUsername"
    />
    <text class="label">密码</text>
    <input
      class="field"
      password
      maxlength="72"
      placeholder="密码"
      value="{{password}}"
      bindinput="onPassword"
    />
    <button class="primary" loading="{{loading}}" disabled="{{loading}}" bindtap="onPasswordLogin">
      {{loading ? "正在登录…" : "登录"}}
    </button>
  </view>

  <view class="card" wx:if="{{mode === 'phone'}}">
    <text class="label">手机号</text>
    <input
      class="field"
      type="number"
      maxlength="11"
      placeholder="11 位手机号"
      value="{{phone}}"
      bindinput="onPhone"
    />
    <text class="label">验证码</text>
    <view class="code-row">
      <input
        class="field code-field"
        type="number"
        maxlength="4"
        placeholder="4 位验证码"
        value="{{smsCode}}"
        bindinput="onSmsCode"
      />
      <button class="btn-ghost code-btn" loading="{{codeLoading}}" disabled="{{codeLoading}}" bindtap="onSendCode">
        {{codeLoading ? "发送中…" : "获取验证码"}}
      </button>
    </view>
    <text class="hint" wx:if="{{devCode}}">开发验证码：{{devCode}}</text>
    <button class="primary" loading="{{loading}}" disabled="{{loading}}" bindtap="onPhoneLogin">
      {{loading ? "正在登录…" : "登录"}}
    </button>
  </view>

  <text class="hint" wx:if="{{notice}}">{{notice}}</text>
  <text class="error" wx:if="{{error}}">{{error}}</text>

  <!-- ZQ-159: product intro on login (before WeChat / account sign-in) -->
  <view class="onboard-mask" wx:if="{{showOnboard}}" catchtouchmove="noop">
    <view class="onboard-sheet">
      <view class="brand-row onboard-brand">
        <image class="brand-logo" src="/images/logo.png" mode="aspectFit" />
        <text class="brand-name">涨球乐</text>
      </view>
      <text class="onboard-title">欢迎来到涨球乐</text>
      <text class="onboard-lead">多打球、约对手、看排名、找教练——让我们大家一起涨球乐。</text>
      <view class="onboard-list">
        <view class="onboard-item" wx:for="{{onboardPoints}}" wx:key="title">
          <view class="onboard-num">{{index + 1}}</view>
          <view class="onboard-copy">
            <text class="onboard-item-title">{{item.title}}</text>
            <text class="onboard-item-desc">{{item.desc}}</text>
          </view>
        </view>
      </view>
      <view class="onboard-actions">
        <button class="btn-ghost onboard-btn" bindtap="dismissOnboard">跳过</button>
        <button class="primary onboard-btn" bindtap="dismissOnboard">开始</button>
      </view>
    </view>
  </view>
</view>
