<view class="page">
  <view class="brand-row">
    <image class="brand-logo" src="/images/logo.png" mode="aspectFit" />
    <text class="brand-name">涨球</text>
  </view>

  <text class="h1">登录</text>
  <text class="lead">登录后进入与网页同源的涨球乐（约球 · 排行榜 · 教练 · 我的）。小程序可用微信登录。</text>

  <view class="mode-row">
    <view
      class="mode-chip {{mode === 'wechat' ? 'mode-chip-on' : ''}}"
      data-mode="wechat"
      bindtap="onMode"
    >微信登录</view>
    <view
      class="mode-chip {{mode === 'password' ? 'mode-chip-on' : ''}}"
      data-mode="password"
      bindtap="onMode"
    >账号密码</view>
    <view
      class="mode-chip {{mode === 'phone' ? 'mode-chip-on' : ''}}"
      data-mode="phone"
      bindtap="onMode"
    >手机验证码</view>
  </view>

  <view class="card" wx:if="{{mode === 'wechat'}}">
    <text class="label">怎么称呼你（可选）</text>
    <input
      class="field"
      type="nickname"
      maxlength="40"
      placeholder="优先用真实名字；可从微信昵称带入"
      value="{{nickName}}"
      bindinput="onNick"
    />
    <button class="primary" loading="{{loading}}" disabled="{{loading}}" bindtap="onWechatLogin">
      {{loading ? "正在登录…" : "微信登录"}}
    </button>
    <text class="hint">首次微信登录会自动创建账号；网页 / APK 不提供此入口。</text>
  </view>

  <view class="card" wx:if="{{mode === 'password'}}">
    <text class="label">用户名或手机号</text>
    <input
      class="field"
      maxlength="40"
      placeholder="用户名或手机号"
      value="{{username}}"
      bindinput="onUsername"
    />
    <text class="label">密码</text>
    <input
      class="field"
      password
      maxlength="72"
      placeholder="密码"
      value="{{password}}"
      bindinput="onPassword"
    />
    <button class="primary" loading="{{loading}}" disabled="{{loading}}" bindtap="onPasswordLogin">
      {{loading ? "正在登录…" : "登录"}}
    </button>
  </view>

  <view class="card" wx:if="{{mode === 'phone'}}">
    <text class="label">手机号</text>
    <input
      class="field"
      type="number"
      maxlength="11"
      placeholder="11 位手机号"
      value="{{phone}}"
      bindinput="onPhone"
    />
    <text class="label">验证码</text>
    <view class="code-row">
      <input
        class="field code-field"
        type="number"
        maxlength="4"
        placeholder="4 位验证码"
        value="{{smsCode}}"
        bindinput="onSmsCode"
      />
      <button class="btn-ghost code-btn" loading="{{codeLoading}}" disabled="{{codeLoading}}" bindtap="onSendCode">
        {{codeLoading ? "发送中…" : "获取验证码"}}
      </button>
    </view>
    <text class="hint" wx:if="{{devCode}}">开发验证码：{{devCode}}</text>
    <button class="primary" loading="{{loading}}" disabled="{{loading}}" bindtap="onPhoneLogin">
      {{loading ? "正在登录…" : "登录"}}
    </button>
  </view>

  <text class="hint" wx:if="{{notice}}">{{notice}}</text>
  <text class="error" wx:if="{{error}}">{{error}}</text>
</view>
