<view class="page">
  <view class="brand-row">
    <image class="brand-logo" src="/images/logo.png" mode="aspectFit" />
    <text class="brand-name">涨球乐</text>
  </view>

  <text class="h1">完善资料</text>

  <view class="card">
    <text class="label">显示名</text>
    <!--
      ZQ-158: nick picker lives here (not on login).
      type="nickname"：点选「可选入微信名」写入本框。
      bindnicknamereview 只有 {pass,timeout}，没有 value；勿绑到清空逻辑（ZQ-154）。
    -->
    <input
      class="field"
      type="nickname"
      maxlength="40"
      placeholder="点选可带入微信名；也可自己填"
      value="{{displayName}}"
      bindinput="onNickInput"
      bindblur="onNickBlur"
      bindchange="onNickInput"
      bindnicknamereview="onNickReview"
    />

    <text class="label">微信号</text>
    <input
      class="field"
      maxlength="32"
      placeholder="请填写真实微信号（约球用）"
      value="{{wechatId}}"
      bindinput="onWechatId"
    />

    <button class="primary" loading="{{loading}}" disabled="{{loading}}" bindtap="onSave">
      {{loading ? "保存中…" : "完成"}}
    </button>
  </view>

  <text class="hint" wx:if="{{notice}}">{{notice}}</text>
  <text class="error" wx:if="{{error}}">{{error}}</text>
</view>
