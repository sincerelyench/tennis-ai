.shot { width: 100%; height: 360rpx; border-radius: 24rpx; margin: 12rpx 0 16rpx; background: #0b1712; }
.axis { margin-bottom: 20rpx; padding-bottom: 12rpx; border-bottom: 1px solid #2d4a3a; }
.axis-top { display: flex; justify-content: space-between; gap: 12rpx; }
.bar { height: 12rpx; border-radius: 99rpx; background: #0b1712; overflow: hidden; margin: 8rpx 0; }
.bar-fill { height: 100%; background: #d6e35a; }
.tip-label, .focus-label { color: #d6e35a; font-size: 22rpx; }
.dim-grid, .speed-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-bottom: 12rpx;
}
.dim-card, .speed-card {
  background: #0c1914;
  border: 1px solid #2d4a3a;
  border-radius: 24rpx;
  padding: 18rpx;
}
.dim-lab { display: block; font-size: 22rpx; color: #8ea196; }
.dim-val { display: flex; align-items: baseline; gap: 6rpx; margin: 10rpx 0 14rpx; }
.dim-score { font-size: 48rpx; font-weight: 750; line-height: 1; }
.dim-max { font-size: 24rpx; color: #8ea196; }
.dim-bar { height: 12rpx; border-radius: 99rpx; background: #07140e; overflow: hidden; }
.dim-fill { height: 100%; background: #d6e35a; }
.speed-val { margin-top: 12rpx; font-size: 40rpx; font-weight: 750; }
.speed-val .unit { font-size: 22rpx; color: #8ea196; font-weight: 500; }
.speed-note { display: block; font-size: 22rpx; color: #8ea196; line-height: 1.45; margin: 8rpx 0 16rpx; }
.charts { margin: 8rpx 0 20rpx; }
.chart-panel {
  background: #0c1914;
  border: 1px solid #2d4a3a;
  border-radius: 24rpx;
  padding: 18rpx;
  margin-bottom: 16rpx;
}
.chart-title { display: block; font-size: 24rpx; color: #8ea196; margin-bottom: 12rpx; }
.radar-wrap {
  position: relative;
  width: 420rpx;
  height: 420rpx;
  margin: 0 auto;
  background:
    linear-gradient(0deg, transparent 49.5%, rgba(45,74,58,.85) 49.5%, rgba(45,74,58,.85) 50.5%, transparent 50.5%),
    linear-gradient(90deg, transparent 49.5%, rgba(45,74,58,.85) 49.5%, rgba(45,74,58,.85) 50.5%, transparent 50.5%),
    radial-gradient(circle at center, transparent 0 28%, rgba(45,74,58,.55) 28% 29%, transparent 29% 48%, rgba(45,74,58,.55) 48% 49%, transparent 49%);
  border-radius: 50%;
}
.radar-poly {
  position: absolute;
  inset: 12%;
  background: rgba(214, 227, 90, 0.35);
  border: 2rpx solid #d6e35a;
}
.radar-lab {
  position: absolute;
  font-size: 22rpx;
  color: #8ea196;
}
.radar-lab.t { top: 0; left: 50%; transform: translateX(-50%); }
.radar-lab.b { bottom: 0; left: 50%; transform: translateX(-50%); }
.radar-lab.l { left: 0; top: 50%; transform: translateY(-50%); }
.radar-lab.r { right: 0; top: 50%; transform: translateY(-50%); }
.hbar-row {
  display: grid;
  grid-template-columns: 4.5em 1fr 2em;
  gap: 12rpx;
  align-items: center;
  margin-bottom: 14rpx;
}
.hbar-lab { font-size: 24rpx; color: #8ea196; }
.hbar-track { height: 18rpx; border-radius: 99rpx; background: #07140e; overflow: hidden; }
.hbar-fill { height: 100%; background: #d6e35a; }
.hbar-num { text-align: right; font-weight: 700; font-size: 26rpx; }
.warn {
  display: block;
  background: rgba(224, 178, 92, 0.16);
  border: 1px solid rgba(224, 178, 92, 0.75);
  color: #ffe7b0;
  border-radius: 20rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
}
.tl {
  display: flex;
  gap: 16rpx;
  align-items: center;
  border: 1px solid #2d4a3a;
  border-radius: 20rpx;
  padding: 12rpx;
  margin-bottom: 12rpx;
}
.tl.on { border-color: #d6e35a; }
.tl-shot { width: 120rpx; height: 90rpx; border-radius: 12rpx; background: #0b1712; flex: 0 0 120rpx; }
.h2 { display: block; font-size: 34rpx; font-weight: 700; margin: 28rpx 0 12rpx; }
.compare { margin-top: 12rpx; }
.compare.locked {
  opacity: 0.72;
  background: #101612;
  border: 1px solid #2d4a3a;
  border-radius: 24rpx;
  padding: 20rpx;
}
.delta { display: block; margin-bottom: 8rpx; }
.up { color: #b7e3c4; }
.down { color: #ffb4b4; }
