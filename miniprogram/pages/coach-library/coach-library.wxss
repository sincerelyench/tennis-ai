.page {
  min-height: 100vh;
  padding: 32rpx;
  background: linear-gradient(180deg, #e8f2ec 0%, #f4f7f5 40%, #eef3f0 100%);
  color: #14201a;
  box-sizing: border-box;
}
.top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}
.brand {
  font-size: 36rpx;
  font-weight: 800;
}
.lang {
  font-size: 24rpx;
  font-weight: 700;
  color: #1f7a4c;
  padding: 8rpx 16rpx;
  background: #e9f7ef;
  border-radius: 999rpx;
}
.hdr {
  margin-bottom: 24rpx;
}
.coach {
  display: block;
  color: #1f7a4c;
  font-size: 24rpx;
  font-weight: 700;
}
.title {
  display: block;
  font-size: 40rpx;
  font-weight: 800;
  margin-top: 8rpx;
}
.lead {
  display: block;
  color: #5b6b63;
  font-size: 26rpx;
  margin-top: 12rpx;
  line-height: 1.45;
}
.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 24rpx;
}
.chip {
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  background: #eef3f0;
  font-size: 24rpx;
}
.chip.on {
  background: #1f7a4c;
  color: #fff;
}
.card {
  border: 1rpx solid #d7e3dc;
  border-radius: 24rpx;
  padding: 24rpx;
  background: #fff;
}
.lbl {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  margin: 16rpx 0 8rpx;
}
.ta {
  width: 100%;
  min-height: 200rpx;
  border: 1rpx solid #d7e3dc;
  border-radius: 16rpx;
  padding: 16rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}
.inp {
  width: 100%;
  border: 1rpx solid #d7e3dc;
  border-radius: 16rpx;
  padding: 16rpx;
  font-size: 28rpx;
  margin-bottom: 16rpx;
  box-sizing: border-box;
}
.vid {
  width: 100%;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
  background: #000;
}
.hint {
  font-size: 24rpx;
  color: #5b6b63;
  margin: 16rpx 0;
}
.err {
  color: #b42318;
}
.ok {
  margin-left: 16rpx;
  color: #1f7a4c;
  font-size: 24rpx;
  font-weight: 700;
}
.publish {
  margin-top: 24rpx;
  margin-bottom: 48rpx;
}
.publish button {
  margin-right: 12rpx;
  margin-top: 12rpx;
}
