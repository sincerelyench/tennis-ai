.page {
  min-height: 100vh;
  padding: 48rpx 40rpx;
  box-sizing: border-box;
  background: linear-gradient(180deg, #f3f7f2 0%, #ffffff 55%);
}
.card {
  padding: 40rpx 32rpx;
  border-radius: 24rpx;
  background: #fff;
  box-shadow: 0 8rpx 32rpx rgba(20, 40, 20, 0.06);
}
.title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1a2e1a;
}
.status {
  margin-top: 24rpx;
  font-size: 30rpx;
  color: #243524;
}
.detail {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: #667566;
}
.primary {
  margin-top: 40rpx;
  background: #2f6b3a;
  color: #fff;
  border-radius: 12rpx;
  font-size: 28rpx;
}
.ghost {
  margin-top: 16rpx;
  background: transparent;
  color: #667566;
  font-size: 26rpx;
}
