<view class="page">
  <view class="brand-row">
    <image class="brand-logo" src="/images/logo.png" mode="aspectFit" />
    <text class="brand-name">涨球</text>
  </view>

  <text class="h1">视频分析</text>
  <text class="lead">先看历史报告。可做挥拍技术分析；上传前会引导侧面拍摄。</text>

  <view class="actions">
    <view class="chip on" bindtap="onNewAnalysis">新的视频分析</view>
    <view class="chip" bindtap="onGuide">拍摄引导</view>
  </view>
  <text class="hint">不足 10 秒可直接提交；更长片段请在上传页确认时长。</text>

  <view class="section">
    <text class="h2">历史报告</text>
    <view class="empty" wx:if="{{!reports.length}}">
      <text class="empty-title">还没有历史报告</text>
      <text class="muted">点「新的视频分析」上传视频。分析完成后会出现在这里。</text>
    </view>
    <view class="card report" wx:for="{{reports}}" wx:key="id" data-id="{{item.id}}" bindtap="onOpenReport">
      <view class="report-top">
        <text class="report-title">{{item.title}}</text>
        <text class="grade {{item.failed ? 'fail' : ''}}">{{item.grade}}</text>
      </view>
      <text class="muted">{{item.when}}</text>
      <text class="snippet" wx:if="{{item.snippet}}">{{item.snippet}}</text>
    </view>
  </view>
</view>
