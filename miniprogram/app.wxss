page {
  background: #ffffff;
  color: #0f172a;
  font-size: 28rpx;
  line-height: 1.5;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Noto Sans SC",
    "Microsoft YaHei", sans-serif;
}

.page {
  min-height: 100vh;
  padding: 24rpx 28rpx 48rpx;
  box-sizing: border-box;
  background: #ffffff;
}

.brand-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 28rpx;
}

.brand-logo {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
}

.brand-name {
  font-size: 36rpx;
  font-weight: 800;
  color: #0f172a;
}

.h1 {
  display: block;
  font-size: 44rpx;
  font-weight: 800;
  color: #0f172a;
  margin-bottom: 8rpx;
}

.lead {
  display: block;
  font-size: 26rpx;
  color: #64748b;
  line-height: 1.55;
  margin-bottom: 24rpx;
}

.card {
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.h2 {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 10rpx;
}

.label {
  display: block;
  font-size: 24rpx;
  color: #64748b;
  margin: 12rpx 0 10rpx;
}

.field,
.picker {
  height: 80rpx;
  line-height: 80rpx;
  padding: 0 22rpx;
  border-radius: 16rpx;
  background: #ffffff;
  border: 1rpx solid #e2e8f0;
  color: #0f172a;
  font-size: 28rpx;
  margin-bottom: 12rpx;
  box-sizing: border-box;
}

.btn-primary,
.primary {
  margin-top: 16rpx;
  background: #0d9488 !important;
  color: #ffffff !important;
  font-weight: 700;
  border-radius: 16rpx !important;
  border: none !important;
}

.btn-primary::after,
.primary::after,
.btn-ghost::after,
.ghost::after {
  border: none;
}

.btn-ghost,
.ghost {
  margin-top: 16rpx;
  background: #ffffff !important;
  color: #0f172a !important;
  border: 1rpx solid #cbd5e1 !important;
  border-radius: 16rpx !important;
  font-weight: 600;
}

.hint {
  display: block;
  margin-top: 14rpx;
  font-size: 24rpx;
  color: #64748b;
  line-height: 1.45;
}

.error {
  display: block;
  color: #ef4444;
  margin-top: 12rpx;
  font-size: 24rpx;
}

.ok {
  display: block;
  color: #0d9488;
  font-weight: 700;
}

.muted {
  color: #64748b;
}

.empty {
  border: 2rpx dashed #cbd5e1;
  border-radius: 20rpx;
  padding: 40rpx 28rpx;
  text-align: center;
  background: #f8fafc;
}

.empty-title {
  display: block;
  font-weight: 700;
  font-size: 30rpx;
  margin-bottom: 10rpx;
}

.actions {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin: 8rpx 0 16rpx;
}

.chip {
  padding: 16rpx 22rpx;
  border-radius: 999rpx;
  border: 1rpx solid #cbd5e1;
  background: #ffffff;
  font-size: 24rpx;
  color: #0f172a;
}

.chip.on {
  background: #0d9488;
  border-color: #0d9488;
  color: #ffffff;
  font-weight: 700;
}
