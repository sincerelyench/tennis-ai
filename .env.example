# cp .env.example .env
CURSOR_API_KEY=
CURSOR_SANDBOX_REPO_URL=https://github.com/your-org/your-sandbox-repo
CURSOR_MODEL_ID=grok-4.6
CURSOR_MODEL_EFFORT=high
CURSOR_MODEL_FAST=false
CURSOR_REUSE_AGENT=1
CURSOR_AGENT_TIMEOUT_MS=180000

OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=nba-dev-sh
OSS_PREFIX=wenbo
OSS_REGION=oss-cn-shanghai
OSS_ENDPOINT=oss-cn-shanghai.aliyuncs.com
OSS_URL_MODE=signed
OSS_SIGNED_URL_SECONDS=604800

# 开发态小程序 / Android 模拟登录。留空时使用内置开发密钥。正式微信登录不走这里。
DEV_AUTH_SECRET=

# /tai 并发：worker 线程数与可排队/运行中的任务上限（L20-2Q ~2GB，默认 2/8）。
TAI_WORKERS=2
TAI_MAX_JOBS=8
# 无进度更新超过该秒数的 queued/running 任务会被标错，释放名额。
TAI_STALE_JOB_S=1200
